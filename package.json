{
    "name": "haema",
    "version": "0.1.0",
    "private": true,
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "desktop:dev": "electron .",
        "desktop:prepare": "next build && node electron/build-standalone.cjs",
        "desktop:build": "npm run desktop:prepare && electron-builder --win nsis"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@c15t/nextjs": "^3.1.0",
        "@clerk/clerk-react": "^5.61.10",
        "@clerk/nextjs": "^7.9.19",
        "@hugeicons/core-free-icons": "^4.3.5",
        "@hugeicons/react": "^1.1.10",
        "@neondatabase/serverless": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "lucide-react": "^1.61.0",
        "motion": "^14.5.0",
        "next": "16.4.2",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-icons": "^5.7.0",
        "shadcn": "^4.22.1",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "electron": "^39.0.0",
        "electron-builder": "^26.0.12",
        "eslint": "^10",
        "eslint-config-next": "16.4.2",
        "tailwindcss": "^4",
        "typescript": "^7"
    },
    "build": {
        "appId": "com.haema.bloodbank",
        "productName": "HAEMA Blood Bank",
        "directories": {
            "output": "dist"
        },
        "files": [
            "electron/**/*",
            ".next/standalone/**/*",
            "package.json",
            "!node_modules/**/*"
        ],
        "extraResources": [
            {
                "from": ".env.local",
                "to": "app/.env.local"
            }
        ],
        "win": {
            "target": "nsis",
            "signAndEditExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
